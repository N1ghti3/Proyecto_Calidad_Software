# TiendaLocal — plantilla de variables de entorno
#
# Copia este archivo como .env y rellena los valores. El archivo .env está
# ignorado por Git y nunca debe versionarse (riesgo R-07, RNF-04).
#
# Los valores de ejemplo de más abajo sirven para desarrollo local. En el
# ambiente desplegado se usan credenciales distintas y contraseñas fuertes.

# =========================================
# Motor de base de datos (lo consume el contenedor de PostgreSQL)
# =========================================
# POSTGRES_USER es el rol propietario del esquema: lo crea el contenedor al
# inicializarse y es el que ejecuta las migraciones de Alembic (ADR-010).
POSTGRES_DB=tiendalocal
POSTGRES_USER=tiendalocal_owner
POSTGRES_PASSWORD=cambia_esta_contrasena

# =========================================
# Conexiones (ADR-010: dos roles con privilegios distintos)
# =========================================
# La aplicación se conecta con un rol que NO puede actualizar ni borrar la
# tabla de auditoría. Ese rol lo crea la migración inicial; antes de ejecutarla
# solo existe el propietario.
#
# Se usa 127.0.0.1 y NO 'localhost' a propósito: docker-compose.yml publica el
# puerto solo en 127.0.0.1, que es IPv4, y en Windows 'localhost' resuelve
# primero a ::1 (IPv6). El primer intento de conexión iría a una dirección
# donde no hay nada escuchando, y según el equipo eso falla rápido o se queda
# esperando el tiempo de espera completo.
DATABASE_URL=postgresql+psycopg://tiendalocal_app:cambia_esta_contrasena_app@127.0.0.1:5432/tiendalocal

# Alembic se conecta con el propietario, que sí puede crear tablas y extensiones.
DATABASE_MIGRATION_URL=postgresql+psycopg://tiendalocal_owner:cambia_esta_contrasena@127.0.0.1:5432/tiendalocal

# Contraseña del rol de la aplicación, usada por la migración que lo crea.
APP_DB_PASSWORD=cambia_esta_contrasena_app

# =========================================
# Autenticación del panel (ADR-006, pendiente de cerrar antes de I-3)
# =========================================
# Cadena larga y aleatoria. Nunca reutilizar entre ambientes.
JWT_SECRET=

# Contraseña del usuario administrador que crea la siembra de DESARROLLO.
# Mínimo 12 caracteres. Solo la usa database/seeds/sembrar_desarrollo.py, y
# nunca se almacena: lo que va a la base es su hash Argon2id (RN-20).
# En un ambiente real no se siembran usuarios de esta manera.
ADMIN_SEED_PASSWORD=cambia_esta_contrasena_admin

# =========================================
# Direcciones de los componentes
# =========================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
